# Diese Variablen kommen NICHT mehr ins Frontend (kein VITE_ Prefix).
# Sie werden nur noch serverseitig in den Vercel Functions verwendet.
#
# Lokal: in .env eintragen, dann npm run dev
# Vercel: unter Settings → Environment Variables eintragen

ANTHROPIC_API_KEY=sk-ant-dein_key_hier
OMDB_API_KEY=dein_omdb_key_hier
